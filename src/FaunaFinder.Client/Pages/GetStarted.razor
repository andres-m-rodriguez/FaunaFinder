@page "/get-started"
@inject IAppLocalizer L
@inject NavigationManager Navigation

<PageTitle>@L["PageTitle_GetStarted"]</PageTitle>

@code {
    private int _currentSlide = 0;
    private const int TotalSlides = 4;
    private bool _isAnimating = false;

    protected override void OnInitialized()
    {
        L.LanguageSignal.OnChange(async () => await InvokeAsync(StateHasChanged));
    }

    private async Task NextSlide()
    {
        if (_currentSlide < TotalSlides - 1 && !_isAnimating)
        {
            _isAnimating = true;
            _currentSlide++;
            StateHasChanged();
            await Task.Delay(300);
            _isAnimating = false;
        }
    }

    private async Task PreviousSlide()
    {
        if (_currentSlide > 0 && !_isAnimating)
        {
            _isAnimating = true;
            _currentSlide--;
            StateHasChanged();
            await Task.Delay(300);
            _isAnimating = false;
        }
    }

    private void GoToSlide(int index)
    {
        if (index >= 0 && index < TotalSlides && !_isAnimating)
        {
            _currentSlide = index;
        }
    }

    private void NavigateToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}

<style>
    .slide-container {
        min-height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
    }

    .slide-content {
        max-width: 1200px;
        width: 100%;
        animation: fadeIn 0.3s ease-in-out;
    }

    .slide-card {
        min-height: 550px;
        display: flex;
        flex-direction: column;
    }

    .slide-card-content {
        flex: 1;
    }

    .slide-nav-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1.5rem;
    }

    .welcome-title {
        font-size: 2.5rem;
        font-weight: 600;
    }

    .welcome-subtitle {
        font-size: 1.25rem;
        font-weight: 400;
    }

    .welcome-description {
        font-size: 1.1rem;
        line-height: 1.6;
        font-weight: 400;
        max-width: 650px;
    }

    .welcome-icon {
        font-size: 4rem;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .slide-indicators {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .slide-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: var(--mud-palette-action-disabled);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .slide-indicator.active {
        background-color: var(--mud-palette-primary);
        transform: scale(1.2);
    }

    .slide-indicator:hover {
        background-color: var(--mud-palette-primary-lighten);
    }

    .coqui-slide {
        position: relative;
        overflow: hidden;
    }

    .coqui-image-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 50%;
        height: 100%;
        overflow: hidden;
        clip-path: polygon(0 0, 100% 0, 70% 100%, 0 100%);
    }

    .coqui-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
    }

    .coqui-content {
        margin-left: 45%;
        padding: 2rem;
        min-height: 350px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .auth-split-container {
        display: flex;
        min-height: 550px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        position: relative;
    }

    .auth-card {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .auth-card-content {
        text-align: center;
        padding: 2rem;
        transition: transform 0.3s ease;
    }

    .auth-card-register {
        background: linear-gradient(135deg, var(--mud-palette-primary-lighten) 0%, var(--mud-palette-primary) 100%);
    }

    .auth-card-register .mud-icon-root,
    .auth-card-register .mud-typography {
        color: white !important;
    }

    .auth-card-register .mud-button-filled {
        background-color: white !important;
        color: var(--mud-palette-primary) !important;
    }

    .auth-card-login {
        background: var(--mud-palette-surface);
    }

    .auth-card:hover {
        flex: 1.15;
    }

    .auth-card:hover .auth-card-content {
        transform: scale(1.05);
    }

    .auth-slide-wrapper {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .auth-back-button {
        margin-left: 0.5rem;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .feature-item {
        text-align: center;
        border-radius: 12px;
        background-color: var(--mud-palette-background-gray);
        transition: transform 0.2s ease;
    }

    .feature-item:hover {
        transform: translateY(-4px);
    }

    /* Tablet responsiveness */
    @@media (max-width: 960px) {
        .welcome-title {
            font-size: 2rem;
        }

        .welcome-subtitle {
            font-size: 1.1rem;
        }

        .welcome-description {
            font-size: 1rem;
        }

        .coqui-image-container {
            width: 45%;
        }

        .coqui-content {
            margin-left: 40%;
            padding: 1.5rem;
        }
    }

    /* Mobile responsiveness */
    @@media (max-width: 600px) {
        .slide-container {
            padding: 1rem;
            min-height: calc(100vh - 56px);
        }

        .slide-content {
            width: 100%;
        }

        .slide-card {
            min-height: auto;
            padding: 1.5rem !important;
        }

        .welcome-title {
            font-size: 1.5rem;
        }

        .welcome-subtitle {
            font-size: 1rem;
        }

        .welcome-description {
            font-size: 0.95rem;
            max-width: 100%;
        }

        .welcome-icon {
            font-size: 3rem !important;
        }

        .coqui-slide {
            padding-bottom: 4rem !important;
        }

        .coqui-image-container {
            position: relative;
            width: 100%;
            height: 180px;
            clip-path: none;
            border-radius: 12px;
            margin-bottom: 1rem;
        }

        .coqui-content {
            margin-left: 0;
            padding: 0 0.5rem;
            min-height: auto;
        }

        .coqui-slide .slide-nav-buttons {
            position: relative !important;
            bottom: auto !important;
            right: auto !important;
            margin-top: 1.5rem;
        }

        .slide-indicators {
            margin-bottom: 1rem;
        }

        .feature-grid {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }

        .feature-item {
            padding: 1rem !important;
        }

        .slide-nav-buttons {
            flex-direction: row;
            justify-content: space-between;
            gap: 0.5rem;
            padding-top: 1rem;
        }

        .slide-nav-buttons .mud-button {
            font-size: 0.8rem;
            padding: 6px 12px;
        }

        .auth-split-container {
            flex-direction: column;
            min-height: auto;
        }

        .auth-card {
            min-height: 250px;
        }

        .auth-card:hover {
            flex: 1;
        }

        .auth-card-content {
            padding: 1.5rem;
        }

        .auth-back-button {
            margin-left: 0;
        }

        .auth-slide-wrapper {
            width: 100%;
        }
    }
</style>

<div class="slide-container">
    <!-- Slide Indicators -->
    <div class="slide-indicators">
        @for (int i = 0; i < TotalSlides; i++)
        {
            var index = i;
            <div class="slide-indicator @(i == _currentSlide ? "active" : "")"
                 @onclick="() => GoToSlide(index)"></div>
        }
    </div>

    <!-- Slide Content -->
    <div class="slide-content" @key="_currentSlide">
        @switch (_currentSlide)
        {
            case 0:
                <!-- Slide 1: Welcome -->
                <MudPaper Elevation="4" Class="pa-8 slide-card">
                    <div class="slide-card-content text-center d-flex flex-column align-center justify-center">
                        <MudIcon Icon="@Icons.Material.Filled.Pets"
                                 Color="Color.Primary"
                                 Class="mb-4 welcome-icon"
                                 Style="font-size: 4rem;" />
                        <MudText Color="Color.Primary" GutterBottom="true" Class="welcome-title">
                            @L["GetStarted_WelcomeTitle"]
                        </MudText>
                        <MudText Color="Color.Secondary" Class="mb-4 welcome-subtitle">
                            @L["GetStarted_WelcomeSubtitle"]
                        </MudText>
                        <MudText Class="mb-6 welcome-description">
                            @L["GetStarted_WelcomeDescription"]
                        </MudText>
                    </div>
                    <div class="slide-nav-buttons">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Disabled="true"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="PreviousSlide">
                            @L["Back"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="NextSlide">
                            @L["GetStarted_Next"]
                        </MudButton>
                    </div>
                </MudPaper>
                break;

            case 1:
                <!-- Slide 2: About with Coqui -->
                <MudPaper Elevation="4" Class="pa-0 slide-card coqui-slide">
                    <div class="coqui-image-container">
                        <img src="images/coqui.jpg" alt="Coquí frog" class="coqui-image" />
                    </div>
                    <div class="coqui-content">
                        <MudText Typo="Typo.h3" Color="Color.Primary" GutterBottom="true" Style="font-weight: 600;">
                            @L["GetStarted_MissionTitle"]
                        </MudText>
                        <MudText Typo="Typo.h6" Class="mb-4" Style="line-height: 1.6; max-width: 500px;">
                            @L["GetStarted_MissionDescription1"]
                        </MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Style="line-height: 1.7; max-width: 480px;">
                            @L["GetStarted_MissionDescription2"]
                        </MudText>
                    </div>
                    <div class="slide-nav-buttons" style="position: absolute; bottom: 1.5rem; right: 1.5rem;">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="PreviousSlide">
                            @L["Back"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="NextSlide">
                            @L["GetStarted_Next"]
                        </MudButton>
                    </div>
                </MudPaper>
                break;

            case 2:
                <!-- Slide 3: For Students -->
                <MudPaper Elevation="4" Class="pa-8 slide-card">
                    <div class="slide-card-content d-flex flex-column align-center justify-center">
                        <div class="text-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.School"
                                     Style="font-size: 4rem;"
                                     Color="Color.Primary" />
                            <MudText Typo="Typo.h3" Color="Color.Primary" GutterBottom="true" Class="mt-2" Style="font-weight: 600;">
                                @L["GetStarted_StudentTitle"]
                            </MudText>
                            <MudText Typo="Typo.h6" Color="Color.Secondary" Style="font-weight: 400; max-width: 600px;">
                                @L["GetStarted_StudentSubtitle"]
                            </MudText>
                        </div>
                        <MudGrid Justify="Justify.Center" Class="mt-2">
                            <MudItem xs="12" sm="11" md="10">
                                <div class="feature-grid">
                                    <MudPaper Elevation="0" Class="pa-4 feature-item">
                                        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Color="Color.Primary" Style="font-size: 2.5rem;" />
                                        <MudText Typo="Typo.subtitle1" Class="mt-2" Style="font-weight: 600;">@L["GetStarted_StudentFeature1"]</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@L["GetStarted_StudentFeature1_Desc"]</MudText>
                                    </MudPaper>
                                    <MudPaper Elevation="0" Class="pa-4 feature-item">
                                        <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Style="font-size: 2.5rem;" />
                                        <MudText Typo="Typo.subtitle1" Class="mt-2" Style="font-weight: 600;">@L["GetStarted_StudentFeature2"]</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@L["GetStarted_StudentFeature2_Desc"]</MudText>
                                    </MudPaper>
                                    <MudPaper Elevation="0" Class="pa-4 feature-item">
                                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Style="font-size: 2.5rem;" />
                                        <MudText Typo="Typo.subtitle1" Class="mt-2" Style="font-weight: 600;">@L["GetStarted_StudentFeature3"]</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@L["GetStarted_StudentFeature3_Desc"]</MudText>
                                    </MudPaper>
                                    <MudPaper Elevation="0" Class="pa-4 feature-item">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Style="font-size: 2.5rem;" />
                                        <MudText Typo="Typo.subtitle1" Class="mt-2" Style="font-weight: 600;">@L["GetStarted_StudentFeature4"]</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@L["GetStarted_StudentFeature4_Desc"]</MudText>
                                    </MudPaper>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </div>
                    <div class="slide-nav-buttons">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="PreviousSlide">
                            @L["Back"]
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="NextSlide">
                            @L["GetStarted_Next"]
                        </MudButton>
                    </div>
                </MudPaper>
                break;

            case 3:
                <!-- Slide 4: Get Access / Login -->
                <div class="auth-slide-wrapper">
                    <div class="auth-back-button">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="PreviousSlide"
                                   Style="color: white;">
                            @L["Back"]
                        </MudButton>
                    </div>
                    <div class="auth-split-container">
                        <div class="auth-card auth-card-register" @onclick="NavigateToRegister">
                            <div class="auth-card-content">
                                <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                                         Style="font-size: 4rem;"
                                         Color="Color.Primary" />
                                <MudText Typo="Typo.h4" Color="Color.Primary" GutterBottom="true" Class="mt-3" Style="font-weight: 600;">
                                    @L["GetStarted_NewHereTitle"]
                                </MudText>
                                <MudText Typo="Typo.body1" Class="mb-4" Style="max-width: 300px;">
                                    @L["GetStarted_NewHereDescription"]
                                </MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Size="Size.Large">
                                    @L["GetStarted_RequestAccess"]
                                </MudButton>
                            </div>
                        </div>
                        <div class="auth-card auth-card-login" @onclick="NavigateToLogin">
                            <div class="auth-card-content">
                                <MudIcon Icon="@Icons.Material.Filled.Login"
                                         Style="font-size: 4rem;"
                                         Color="Color.Secondary" />
                                <MudText Typo="Typo.h4" Color="Color.Secondary" GutterBottom="true" Class="mt-3" Style="font-weight: 600;">
                                    @L["GetStarted_HaveAccountTitle"]
                                </MudText>
                                <MudText Typo="Typo.body1" Class="mb-4" Style="max-width: 300px;">
                                    @L["GetStarted_HaveAccountDescription"]
                                </MudText>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Size="Size.Large">
                                    @L["GetStarted_Login"]
                                </MudButton>
                            </div>
                        </div>
                    </div>
                </div>
                break;
        }
    </div>
</div>
