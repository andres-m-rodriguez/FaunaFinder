@inject IAppLocalizer L

<MudPaper Elevation="0" Class="pa-3 mb-2 bg-subtle">
    <div class="d-flex align-start gap-2 mb-2">
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
            NRCS @Link.NrcsPractice.Code
        </MudChip>
        <MudText Typo="Typo.body1">@L.GetLocalizedValue(Link.NrcsPractice.Name)</MudText>
    </div>
    <div class="d-flex align-start gap-2 mb-2">
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
            FWS @Link.FwsAction.Code
        </MudChip>
        <MudText Typo="Typo.body1">@L.GetLocalizedValue(Link.FwsAction.Name)</MudText>
    </div>
    @if (Link.Justification.Count > 0)
    {
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.body2">
            @L.GetLocalizedValue(Link.Justification)
        </MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public FwsLinkDto Link { get; set; } = null!;
}
