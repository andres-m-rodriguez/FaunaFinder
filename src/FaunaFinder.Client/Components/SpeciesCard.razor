@inject IAppLocalizer L

<MudCard Elevation="0" Class="species-card" @onclick="OnClick">
    <MudCardContent>
        <div class="d-flex align-center gap-3">
            <div class="species-card-icon">
                <MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Medium" Color="Color.Tertiary" />
            </div>
            <div class="flex-1">
                <MudText Typo="Typo.subtitle1" Class="font-semibold">@L.GetLocalizedValue(CommonName)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="italic">
                    @ScientificName
                </MudText>
                @if (ShowMunicipalityCount)
                {
                    <div class="d-flex align-center mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @MunicipalityCount @(MunicipalityCount == 1 ? L["Species_Municipality"] : L["Species_Municipalities"])
                        </MudText>
                    </div>
                }
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" Class="species-card-chevron" />
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public List<LocaleValue> CommonName { get; set; } = [];

    [Parameter, EditorRequired]
    public string ScientificName { get; set; } = string.Empty;

    [Parameter]
    public int MunicipalityCount { get; set; }

    [Parameter]
    public bool ShowMunicipalityCount { get; set; } = true;

    [Parameter]
    public EventCallback OnClick { get; set; }

    protected override void OnInitialized()
    {
        L.LanguageSignal.OnChange(async () => await InvokeAsync(StateHasChanged));
    }
}
