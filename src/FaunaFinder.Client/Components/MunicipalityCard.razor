@inject IAppLocalizer L

<MudCard Elevation="0" Class="municipality-card" @onclick="OnClick">
    <MudCardContent Class="@ContentClass">
        @if (Compact)
        {
            <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.body1" Color="Color.Primary">@Name</MudText>
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <div class="municipality-card-icon">
                    <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Medium" Color="Color.Primary" />
                </div>
                <div class="flex-1">
                    <MudText Typo="Typo.subtitle1" Class="font-semibold">@Name</MudText>
                    @if (ShowSpeciesCount)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                            @SpeciesCount @L["Pueblos_Species"]
                        </MudText>
                    }
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" Class="municipality-card-chevron" />
            </div>
        }
    </MudCardContent>
</MudCard>

@code {
    [CascadingParameter(Name = "LanguageRefresh")]
    private int LanguageRefresh { get; set; }

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int SpeciesCount { get; set; }

    [Parameter]
    public bool ShowSpeciesCount { get; set; } = true;

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string ContentClass => Compact ? "d-flex align-center justify-center pa-3" : string.Empty;
}
